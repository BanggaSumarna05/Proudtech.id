{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "healthcheckPath": "/",
    "preDeployCommand": "php artisan migrate --force",
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE"
  }
}